# ---------------------------------------------------------------------------
# Supabase (Project Settings → API). The publishable key is safe in the browser;
# RLS enforces access. Never put the service-role key in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public URL of the deployed app — used for magic-link / OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Not needed in Phase 1 (all reads/writes go through the signed-in
# user + RLS). Phase 3 uses it for webhooks (n8n, Twilio) and paid enrichment.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3+ (server-only; set as Firebase App Hosting secrets, never commit)
# N8N_WEBHOOK_SECRET=
# N8N_BASE_URL=https://honest122.app.n8n.cloud
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
